# ==========================================================================
#  AgentHack — Autonomous AI Sales Agent — Environment Variables
#  Copy this file to `.env` (root) and fill in the values.
#  The frontend reads only NEXT_PUBLIC_* keys from frontend/.env.local.
#
#  NOTE: keep comments on their OWN lines (never after `KEY=`). An inline
#  comment on an empty-value line is parsed as the value by python-dotenv.
# ==========================================================================

# ── LLM providers ─────────────────────────────────────────────────────────
# Primary LLM (Llama 3.3/4 via Groq free tier) — required for the demo.
GROQ_API_KEY=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
# Gemini Flash fallback AND Google Calendar API (optional).
GOOGLE_API_KEY=AQ.Ab8RN6LXZBXB3ix7iyLd-p0W7v0RlaYUeBPBx7lermH72XMm9g
# Gemini fallback model id (the "-latest" alias tracks current stable Flash, so it never 404s on retirement).
GEMINI_MODEL=gemini-flash-latest

# ── Search / research ─────────────────────────────────────────────────────
# Primary web/company search (LLM-ready summaries) — required for the demo.
TAVILY_API_KEY=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
# Backup search (google.serper.dev) — optional.
SERPER_API_KEY=

# ── Email (Gmail API, OAuth) ──────────────────────────────────────────────
# Only needed when EMAIL_MODE=send. Leave blank to simulate (log only).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# From address used for outreach (e.g. you@gmail.com).
GMAIL_SENDER=

# ── Calendar / Meet ───────────────────────────────────────────────────────
# Path to OAuth/service-account credentials JSON file (only for MEETING_MODE=create).
GOOGLE_CALENDAR_CREDENTIALS=
# "simulate" (placeholder link) or "create" (real Google Calendar/Meet event).
MEETING_MODE=simulate

# ── Long-term memory (Supabase Postgres) ──────────────────────────────────
# Supabase project URL.
SUPABASE_URL=
# service_role or anon key (used server-side only).
SUPABASE_KEY=
# "auto" (Supabase if BOTH keys set, else in-memory) | "memory" | "supabase".
MEMORY_BACKEND=auto

# ── WhatsApp microservice wiring (Node + Baileys) ─────────────────────────
# Python -> Node (send WhatsApp).
WHATSAPP_SERVICE_URL=http://localhost:3001
# Node -> Python (inbound webhook).
PYTHON_BACKEND_URL=http://localhost:8000
# Port the Node service listens on.
WHATSAPP_PORT=3001
# Admin number for meeting reminders, digits only (e.g. 15551234567).
ADMIN_WHATSAPP_NUMBER=

# ── Backend runtime paths ─────────────────────────────────────────────────
# Chroma vector store persistence dir.
CHROMA_PERSIST_DIR=./data/chroma
# LangGraph SQLite checkpointer.
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite
# Where uploaded company PDFs are stored.
UPLOAD_DIR=./data/uploads

# ── App behaviour ─────────────────────────────────────────────────────────
# Comma-separated allowed frontend origins.
CORS_ORIGINS=http://localhost:3000
# Default Groq model id.
LLM_MODEL=llama-3.3-70b-versatile
# "simulate" (log only) or "send" (real Gmail) — spec allows either.
EMAIL_MODE=simulate
# Scheduling/booking URL added to outreach when set (e.g. Calendly).
BOOKING_LINK=

# ── Frontend (put this one in frontend/.env.local, not the root .env) ──────
# Browser -> FastAPI backend base URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
